---
// R2Image.astro
// Serves images from local /images/ in dev, R2 CDN in production
// Uses Astro.url.hostname for dev detection (avoids import.meta.env issues with Cloudflare adapter)

import {
  generateR2Srcset,
  DEFAULT_R2_CONFIG,
} from '../../lib/r2-utils'

export interface Props {
  src: string
  alt: string
  width?: number
  height?: number
  format?: 'webp' | 'avif' | 'auto'
  loading?: 'lazy' | 'eager'
  class?: string
  sizes?: string
  aspectRatio?: string
  r2Domain?: string
  imagePath?: string
  widths?: number[]
  defaultFormat?: string
  aspectRatioClass?: string
}

const {
  src,
  alt,
  width,
  height,
  format,
  loading = 'lazy',
  class: className,
  sizes,
  aspectRatio,
  r2Domain = DEFAULT_R2_CONFIG.r2Domain,
  imagePath = DEFAULT_R2_CONFIG.imagePath,
  widths = DEFAULT_R2_CONFIG.widths,
  defaultFormat = DEFAULT_R2_CONFIG.defaultFormat,
  aspectRatioClass = 'w-full h-full object-cover',
} = Astro.props

const r2Config = { r2Domain, imagePath, widths, defaultFormat, fallbackToR2: true }

// Detect dev vs prod via hostname (avoids import.meta.env MagicString conflict with Cloudflare adapter)
const isDev = Astro.url.hostname === 'localhost' || Astro.url.hostname === '127.0.0.1'

// Generate optimized image URL
const generateImageUrl = (
  imgSrc: string,
  imgWidth?: number,
  preferredFormat?: string,
) => {
  if (imgSrc.startsWith('http')) return imgSrc

  // SVG files: no resizing
  if (imgSrc.endsWith('.svg')) {
    return isDev ? `/${imagePath}/${imgSrc}` : `${r2Domain}/${imagePath}/${imgSrc}`
  }

  // Dev mode: serve from local public/images/
  if (isDev) {
    return `/${imagePath}/${imgSrc}`
  }

  // Production: serve responsive variant from R2
  if (imgWidth) {
    const nameWithoutExt = imgSrc.replace(/\.[^.]+$/, '')
    const targetWidth = widths.find((w) => w >= imgWidth) || widths[widths.length - 1]
    const targetFormat = preferredFormat || format || defaultFormat
    return `${r2Domain}/${imagePath}/${nameWithoutExt}-${targetWidth}.${targetFormat}`
  }

  // Production fallback: original from R2
  return `${r2Domain}/${imagePath}/${imgSrc}`
}

const imageUrl = generateImageUrl(src, width, format)

// Generate srcset for production only
const srcset = isDev ? undefined : generateR2Srcset(src, format || defaultFormat, r2Config)

// Container styles for aspect ratio
const containerStyle = aspectRatio ? `aspect-ratio: ${aspectRatio};` : undefined
---

{
  aspectRatio ? (
    <div
      style={containerStyle}
      class={className}
    >
      <img
        src={imageUrl}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        srcset={srcset}
        sizes={sizes}
        class={aspectRatioClass}
      />
    </div>
  ) : (
    <img
      src={imageUrl}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      srcset={srcset}
      sizes={sizes}
      class={className}
    />
  )
}
