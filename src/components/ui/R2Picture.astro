---
// R2Picture.astro
// <picture> element with multiple format sources (AVIF, WebP) for browser-level format negotiation
// Uses Astro.url.hostname for dev detection (avoids import.meta.env issues with Cloudflare adapter)

import r2Config from '../../config/r2-images'
import { isExternalImageSource } from '../../lib/r2-utils'

export interface Props {
  src: string
  alt: string
  sizes?: string
  widths?: number[]
  formats?: ('avif' | 'webp' | 'original')[]
  loading?: 'lazy' | 'eager'
  class?: string
  pictureClass?: string
  aspectRatio?: string
  r2Domain?: string
  imagePath?: string
  defaultFormat?: 'webp' | 'avif' | 'auto'
  aspectRatioClass?: string
}

const {
  src,
  alt,
  sizes = '100vw',
  widths: configuredWidths = r2Config.widths || [400, 800, 1200],
  formats = r2Config.formats || ['webp'],
  loading = 'lazy',
  class: imgClass,
  pictureClass,
  aspectRatio,
  r2Domain = r2Config.domain,
  imagePath = r2Config.imagePath,
  defaultFormat = r2Config.defaultFormat,
  aspectRatioClass = r2Config.aspectRatioClass || 'w-full h-full object-cover',
} = Astro.props

const validWidths = [...configuredWidths]
  .filter((value) => value > 0)
  .sort((a, b) => a - b)
const widths = validWidths.length ? validWidths : [400, 800, 1200]
const normalizedDefaultFormat = defaultFormat === 'auto' ? 'webp' : defaultFormat

// Detect dev vs prod via hostname
const isDev = Astro.url.hostname === 'localhost' || Astro.url.hostname === '127.0.0.1'

// Generate srcset for a specific format
const generateSrcset = (format: string) => {
  if (!src || isExternalImageSource(src) || src.endsWith('.svg')) {
    return undefined
  }

  // Dev mode: local path only
  if (isDev) {
    return `/${imagePath}/${src}`
  }

  const nameWithoutExt = src.replace(/\.[^.]+$/, '')
  return widths
    .map((width) => `${r2Domain}/${imagePath}/${nameWithoutExt}-${width}.${format} ${width}w`)
    .join(', ')
}

// Default fallback URL
const getDefaultUrl = () => {
  if (isExternalImageSource(src)) return src

  if (isDev) {
    return `/${imagePath}/${src}`
  }

  if (src.endsWith('.svg')) {
    return `${r2Domain}/${imagePath}/${src}`
  }

  const nameWithoutExt = src.replace(/\.[^.]+$/, '')
  const defaultWidth = widths[Math.floor(widths.length / 2)] || 800
  return `${r2Domain}/${imagePath}/${nameWithoutExt}-${defaultWidth}.${normalizedDefaultFormat}`
}

const getOriginalUrl = () => {
  if (isExternalImageSource(src)) return src
  return isDev ? `/${imagePath}/${src}` : `${r2Domain}/${imagePath}/${src}`
}

const defaultUrl = getDefaultUrl()
const originalUrl = getOriginalUrl()
const containerStyle = aspectRatio ? `aspect-ratio: ${aspectRatio};` : undefined
---

{
  aspectRatio ? (
    <div
      style={containerStyle}
      class={pictureClass}
    >
      <picture class='w-full h-full'>
        {!isDev && formats.includes('avif') && (
          <source
            type='image/avif'
            srcset={generateSrcset('avif')}
            sizes={sizes}
          />
        )}

        {!isDev && formats.includes('webp') && (
          <source
            type='image/webp'
            srcset={generateSrcset('webp')}
            sizes={sizes}
          />
        )}

        {!isDev && formats.includes('original') && (
          <source srcset={originalUrl} />
        )}

        <img
          src={defaultUrl}
          alt={alt}
          loading={loading}
          class={aspectRatioClass}
          decoding='async'
        />
      </picture>
    </div>
  ) : (
    <picture class={pictureClass}>
      {!isDev && formats.includes('avif') && (
        <source
          type='image/avif'
          srcset={generateSrcset('avif')}
          sizes={sizes}
        />
      )}

      {!isDev && formats.includes('webp') && (
        <source
          type='image/webp'
          srcset={generateSrcset('webp')}
          sizes={sizes}
        />
      )}

      {!isDev && formats.includes('original') && (
        <source srcset={originalUrl} />
      )}

      <img
        src={defaultUrl}
        alt={alt}
        loading={loading}
        class={imgClass}
        decoding='async'
      />
    </picture>
  )
}
